# Copy this file to ".env" and fill in your anon key.
# The anon/publishable key is DESIGNED to be public in frontend code —
# safety comes from Supabase Row Level Security (see supabase_schema.sql),
# not from hiding this key. Never put a service_role key in this project.

VITE_SUPABASE_URL=https://ezwkyihqecmhcsoyvtgs.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY_HERE
